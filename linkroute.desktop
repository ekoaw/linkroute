[Desktop Entry]
Version=1.0
Type=Application
Name=linkroute
Comment=Opens work links in the work browser profile, others in the default one
Exec=linkroute %u
Icon=web-browser
Terminal=false
NoDisplay=true
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
