#!/bin/sh
# Default-browser shim: opens links to work domains in a separate Brave
# instance (own user-data-dir and window class), everything else in the
# regular one.
set -u

conf_dir="${XDG_CONFIG_HOME:-$HOME/.config}/linkroute"
browser=brave
work_data_dir="$HOME/.config/BraveSoftware/Brave-Browser-Work"
work_class=brave-work
[ -r "$conf_dir/config" ] && . "$conf_dir/config"

url="${1-}"
host=$(printf '%s\n' "$url" | sed -nE 's#^[a-zA-Z][a-zA-Z0-9+.-]*://([^@/]*@)?([^:/?#]+).*#\2#p' | tr 'A-Z' 'a-z')

if [ -n "$host" ] && [ -r "$conf_dir/work-domains" ]; then
  while IFS= read -r d; do
    case "$d" in ''|'#'*) continue ;; esac
    case "$d" in
      *.) case "$host" in "$d"*) work=1 ;; esac ;;
      *)  case "$host" in "$d"|*."$d") work=1 ;; esac ;;
    esac
    [ -n "${work-}" ] && exec "$browser" --user-data-dir="$work_data_dir" --class="$work_class" "$url"
  done < "$conf_dir/work-domains"
fi
exec "$browser" "$@"
